{
  "_comment": "Template only - no staging host exists yet. Copy to staging.json and fill in remoteRoot/healthUrl/frontendUrl once one does. host/credentials still come from DEPLOY_FTP_* env vars, never from this file.",
  "environment": "staging",
  "protocol": "FTPS",
  "host": null,
  "remoteRoot": "staging.example.com",
  "wwwrootRelativePath": "wwwroot",
  "healthUrl": "https://staging.example.com/health",
  "frontendUrl": "https://staging.example.com/",
  "maxParallelUploads": 4,
  "operationTimeoutSeconds": 60,
  "dllUnlockTimeoutSeconds": 45,
  "lockStaleMinutes": 15,
  "lockHeartbeatSeconds": 60,
  "retryDelaysSeconds": [1, 3, 7],
  "healthCheckRetrySeconds": 2,
  "healthCheckTimeoutSeconds": 60,
  "deleteSafetyLimitCount": 50,
  "deleteSafetyLimitPct": 20,
  "protectedPaths": [
    ".env", ".env.*",
    "uploads/", "storage/", "logs/", "sessions/", "cache/",
    "*.mdf", "*.ldf", "*.ndf", "*.bak", "*.sqlite", "*.sqlite3", "*.db"
  ],
  "runtimeSensitivePatterns": [
    "*.dll", "*.exe", "*.deps.json", "*.runtimeconfig.json"
  ]
}
