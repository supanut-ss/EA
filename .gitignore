# ---------- Node / React (Frontend) ----------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Env / secrets ----------
.env
.env.*.local
.env.local

# ---------- .NET / C# (Backend) ----------
bin/
obj/
*.user
*.suo
.vs/
*.pubxml
*.pubxml.user
publish/
Backend/EaConsole.Api/wwwroot/

# ---------- Deploy staging (deploy.ps1 output - contains a self-contained
# publish + a web.config patched with real runtime secrets, never commit) ----------
/deploy/

# ---------- Deploy manifest cache (local file hashes from prior verified
# uploads - machine-specific optimization state, not meaningful to share) ----------
/.deploy-cache/

# ---------- Old FTPS deploy system (deployment/) runtime output - retired,
# folder removed in favor of deploy-single-host.ps1; left ignored in case
# stray local build output remains on a dev machine ----------
/.deploy/

# ---------- Local single-host deploy wrapper - copied from
# deploy-single-host.example.ps1 and allowed to reference machine secrets.
# Shared behavior belongs in deploy-single-host.core.ps1. ----------
/deploy-single-host.ps1

# ---------- SQL local data / dumps ----------
*.mdf
*.ldf
*.ndf
*.bak

# ---------- MQL5 / MT5 (MQ5) ----------
**/*.ex5
**/*.ex4
MQ5/Backtest/compile_log*.txt
MQ5/Backtest/*Report*.htm
MQ5/Backtest/*.pass

# ---------- Claude Code local settings ----------
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# ---------- Local scratch ----------
.scratch-dbfix/

# ---------- Editor / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
