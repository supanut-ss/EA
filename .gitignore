# ---------- Node / React (Frontend) ----------
node_modules/
dist/
dist-ssr/
build/
.vite/
*.local
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Env / secrets ----------
.env
.env.*.local
.env.local

# ---------- .NET / C# (Backend) ----------
bin/
obj/
*.user
*.suo
.vs/
*.pubxml
*.pubxml.user
publish/
Backend/EaConsole.Api/wwwroot/

# ---------- Deploy staging (deploy.ps1 output - contains a self-contained
# publish + a web.config patched with real runtime secrets, never commit) ----------
/deploy/

# ---------- Deploy manifest cache (local file hashes from prior verified
# uploads - machine-specific optimization state, not meaningful to share) ----------
/.deploy-cache/

# ---------- New FTPS deploy system (deployment/) runtime output - build
# artifacts, downloaded remote manifests, local logs; never commit. The
# scripts themselves live in /deployment/ (tracked) and are unaffected. ----------
/.deploy/

# ---------- Local deploy credentials wrapper - deployment/run-deploy.local.ps1
# holds real FTP/DB/API secrets filled in by hand, never commit it ----------
deployment/*.local.ps1

# ---------- Simple single-host deploy script (eTPL-style) - has real FTP/DB/
# API secrets hardcoded inline by design, never commit it ----------
/deploy-single-host.ps1

# ---------- SQL local data / dumps ----------
*.mdf
*.ldf
*.ndf
*.bak

# ---------- MQL5 / MT5 (MQ5) ----------
**/*.ex5
**/*.ex4
MQ5/Backtest/compile_log*.txt
MQ5/Backtest/*Report*.htm
MQ5/Backtest/*.pass

# ---------- Claude Code local settings ----------
**/.claude/settings.local.json
**/.claude/scheduled_tasks.lock

# ---------- Editor / OS ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
